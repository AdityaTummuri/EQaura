import { Model, HealthRow, DeviceRow, Tone } from "../model.slint";
import { Theme } from "../theme.slint";
import { Card, Badge, Divider } from "../widgets/card.slint";
import { Btn } from "../widgets/button.slint";
import { Icon } from "../widgets/icon.slint";
import { ScrollArea } from "../widgets/scroll.slint";
import { PageFrame, PageHeader } from "../widgets/page.slint";

component HealthItem inherits Rectangle {
    in property <HealthRow> entry;
    in property <int> index;
    preferred-height: l.preferred-height;
    accessible-role: AccessibleRole.text;
    accessible-label: root.entry.title + ". " + root.entry.detail;
    l := HorizontalLayout {
        padding: 16px;
        spacing: 14px;
        Rectangle {
            width: 32px;
            height: 32px;
            horizontal-stretch: 0;
            border-radius: 16px;
            background: Theme.tone-soft(root.entry.tone);
            Icon { name: Theme.tone-icon(root.entry.tone); size: 18px; tint: Theme.tone-color(root.entry.tone); x: 7px; y: 7px; }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            alignment: center;
            Text { text: root.entry.title; color: Theme.text; font-size: Theme.fs-body + 1px; font-weight: 600; wrap: word-wrap; }
            Text { text: root.entry.detail; color: Theme.text-2; font-size: Theme.fs-body; wrap: word-wrap; }
        }
        if root.entry.action != "": VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            Btn { text: root.entry.action; compact: true; clicked => { Model.health-action(root.index); } }
        }
    }
}

component DeviceItem inherits Rectangle {
    in property <DeviceRow> entry;
    height: 64px;
    accessible-role: AccessibleRole.text;
    accessible-label: root.entry.name + ", " + root.entry.detail + ", profile " + root.entry.profile + (root.entry.is-default ? ", default device" : "");
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 14px;
        Rectangle {
            width: 20px;
            horizontal-stretch: 0;
            Icon { name: "device"; size: 20px; tint: Theme.text-2; y: (parent.height - self.height) / 2; }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text { text: root.entry.name; color: Theme.text; font-size: Theme.fs-body + 1px; font-weight: 600; overflow: elide; }
            Text { text: root.entry.detail; color: Theme.text-2; font-size: Theme.fs-small; overflow: elide; }
        }
        Rectangle {
            horizontal-stretch: 0;
            preferred-width: tags.preferred-width;
            tags := HorizontalLayout {
                spacing: 6px;
                alignment: end;
                if root.entry.is-default: Badge { y: (parent.height - self.height) / 2; text: "Default"; tone: Tone.good; }
                Badge { y: (parent.height - self.height) / 2; text: "Profile: " + root.entry.profile; icon: "presets"; }
            }
        }
    }
}

export component SystemPage inherits Rectangle {
    PageFrame {
        ScrollArea {
            VerticalLayout {
                padding-top: 24px;
                padding-bottom: 24px;
                padding-right: 14px;
                spacing: 20px;
                PageHeader {
                    title: "System";
                    subtitle: "Whether the equalizer is really working on your computer, and where it is applied.";
                }
                Card {
                    preferred-height: eng.preferred-height;
                    eng := HorizontalLayout {
                        padding: 20px;
                        spacing: 16px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 6px;
                            alignment: center;
                            Text { text: "Engine"; color: Theme.text-2; font-size: Theme.fs-body; }
                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                Badge { text: Model.engine-status; tone: Model.engine-tone; dot: true; }
                                Text { text: Model.enabled ? "Equalizer is on" : "Equalizer is off"; color: Theme.text; font-size: Theme.fs-lead; font-weight: 600; vertical-alignment: center; horizontal-stretch: 0; }
                            }
                        }
                        VerticalLayout {
                            spacing: 2px;
                            alignment: center;
                            Text { text: "Output device"; color: Theme.text-2; font-size: Theme.fs-small; horizontal-alignment: right; }
                            Text { text: Model.device-name; color: Theme.text; font-size: Theme.fs-body + 1px; font-weight: 600; horizontal-alignment: right; overflow: elide; }
                        }
                    }
                }
                Card {
                    preferred-height: hv.preferred-height;
                    hv := VerticalLayout {
                        HorizontalLayout {
                            padding: 16px;
                            padding-bottom: 12px;
                            spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "Health check"; color: Theme.text; font-size: Theme.fs-lead; font-weight: 600; }
                                Text { text: "A few quick checks of the things the equalizer depends on."; color: Theme.text-2; font-size: Theme.fs-body; wrap: word-wrap; }
                            }
                            VerticalLayout {
                                horizontal-stretch: 0;
                                alignment: center;
                                Btn {
                                    text: Model.health-busy ? "Checking" : "Check again";
                                    icon: "refresh";
                                    enabled: !Model.health-busy;
                                    clicked => { Model.health-refresh(); }
                                }
                            }
                        }
                        for entry[i] in Model.health: VerticalLayout {
                            Divider { }
                            HealthItem { entry: entry; index: i; }
                        }
                    }
                }
                Card {
                    preferred-height: dv.preferred-height;
                    dv := VerticalLayout {
                        VerticalLayout {
                            padding: 16px;
                            padding-bottom: 12px;
                            spacing: 2px;
                            Text { text: "Devices"; color: Theme.text; font-size: Theme.fs-lead; font-weight: 600; }
                            Text { text: "Each output device keeps its own profile. Switching device switches profile."; color: Theme.text-2; font-size: Theme.fs-body; wrap: word-wrap; }
                        }
                        if Model.devices.length == 0: Rectangle {
                            height: 56px;
                            Text {
                                x: 16px;
                                text: "No output devices found.";
                                color: Theme.text-2;
                                font-size: Theme.fs-body;
                                vertical-alignment: center;
                            }
                        }
                        for entry[i] in Model.devices: VerticalLayout {
                            Divider { }
                            DeviceItem { entry: entry; }
                        }
                    }
                }
            }
        }
    }
}
