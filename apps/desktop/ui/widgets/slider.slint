import { Theme } from "../theme.slint";
import { FocusRing } from "focus.slint";

// Horizontal slider, 0..1 by default. Reports every change while dragging and once on release.
export component HSlider inherits Rectangle {
    in property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <float> step: 0.05;
    in property <bool> enabled: true;
    in property <string> label;
    callback changed(float);
    callback released();

    private property <length> thumb: 18px;
    private property <float> frac: root.maximum > root.minimum ? Math.min(1, Math.max(0, (root.value - root.minimum) / (root.maximum - root.minimum))) : 0;
    private property <length> thumb-x: root.frac * (root.width - root.thumb);

    pure function at(x: length) -> float {
        return root.minimum + Math.min(1, Math.max(0, (x - root.thumb / 2) / (root.width - root.thumb))) * (root.maximum - root.minimum);
    }

    height: 24px;
    min-width: 80px;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: root.value;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.step;
    accessible-enabled: root.enabled;

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.surface-3;
        Rectangle {
            x: 0px;
            width: root.thumb-x + root.thumb / 2;
            height: 100%;
            border-radius: 2px;
            background: root.enabled ? Theme.accent : Theme.text-3;
        }
    }
    Rectangle {
        x: root.thumb-x;
        y: (parent.height - self.height) / 2;
        width: root.thumb;
        height: root.thumb;
        border-radius: root.thumb / 2;
        background: root.enabled ? (Theme.dark ? Theme.text : #FFFFFF) : Theme.surface-3;
        border-width: 1px;
        border-color: root.enabled ? (ta.pressed ? Theme.accent : Theme.line-strong) : Theme.line;
        drop-shadow-blur: Theme.dark ? 0px : 3px;
        drop-shadow-color: #1B1A1728;
        drop-shadow-offset-y: 1px;
        animate border-color { duration: Theme.dur-fast; }
    }
    FocusRing { show: fs.has-focus; radius: 12px; height: parent.height + 6px; }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.changed(root.at(ta.mouse-x));
            }
            if (e.kind == PointerEventKind.up) { root.released(); }
        }
        moved => { root.changed(root.at(ta.mouse-x)); }
    }
    fs := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(e) => {
            if (e.text == Key.LeftArrow || e.text == Key.DownArrow) { root.changed(Math.max(root.minimum, root.value - root.step)); root.released(); return accept; }
            if (e.text == Key.RightArrow || e.text == Key.UpArrow) { root.changed(Math.min(root.maximum, root.value + root.step)); root.released(); return accept; }
            return reject;
        }
    }
}
