import { Theme } from "../theme.slint";
import { FocusRing } from "focus.slint";

// Switch. The caller owns the state: this only reports what the user asked for.
export component Toggle inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <string> label;
    callback toggled(bool);

    horizontal-stretch: 0;
    width: 38px;
    height: 22px;
    border-radius: 11px;
    border-width: root.checked ? 0px : 1px;
    border-color: Theme.line-strong;
    background: !root.enabled ? Theme.surface-3.with-alpha(0.6)
        : root.checked ? (ta.pressed ? Theme.accent-press : ta.has-hover ? Theme.accent-hover : Theme.accent)
        : (ta.pressed ? Theme.line-strong : ta.has-hover ? Theme.surface-3 : Theme.surface-2);
    animate background { duration: Theme.dur; easing: ease-out; }
    accessible-role: switch;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.toggled(!root.checked); } }

    Rectangle {
        width: 16px;
        height: 16px;
        border-radius: 8px;
        y: (parent.height - self.height) / 2;
        x: root.checked ? parent.width - self.width - 3px : 3px;
        background: !root.enabled ? Theme.text-3 : root.checked ? Theme.accent-on : Theme.text-2;
        animate x { duration: Theme.dur; easing: ease-out; }
    }
    FocusRing { show: fs.has-focus; radius: 11px; }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.checked); }
    }
    fs := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(e) => {
            if (e.text == " " || e.text == Key.Return) { root.toggled(!root.checked); return accept; }
            return reject;
        }
    }
}

// Title and plain-English help on the left, a switch on the right.
export component ToggleRow inherits Rectangle {
    in property <string> title;
    in property <string> help;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    preferred-height: l.preferred-height;
    min-height: l.min-height;
    l := HorizontalLayout {
        spacing: 16px;
        VerticalLayout {
            spacing: 2px;
            alignment: center;
            Text {
                text: root.title;
                color: root.enabled ? Theme.text : Theme.text-3;
                font-size: Theme.fs-body;
                font-weight: 500;
                overflow: elide;
            }
            if root.help != "": Text {
                text: root.help;
                color: Theme.text-2;
                font-size: Theme.fs-small;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            alignment: center;
            Toggle {
                checked: root.checked;
                enabled: root.enabled;
                label: root.title;
                toggled(v) => { root.toggled(v); }
            }
        }
    }
}
