// The equalizer graph: log frequency across, dB up. Curves come from Rust as pixel
// paths for the plot area; this file only draws them and turns pointer and keyboard
// input into Model callbacks.
import { Model, Band } from "model.slint";
import { Theme } from "theme.slint";
import { Fmt } from "format.slint";
import { Icon } from "widgets/icon.slint";

// A path whose coordinates are plain pixels of its own box.
component PxPath inherits Path {
    viewbox-x: 0;
    viewbox-y: 0;
    viewbox-width: self.width / 1px;
    viewbox-height: self.height / 1px;
    stroke-line-cap: round;
    stroke-line-join: round;
}

component LegendItem inherits Rectangle {
    in property <string> text;
    in property <color> swatch;
    in property <bool> faint: false;
    height: 18px;
    min-width: l.min-width;
    preferred-width: l.preferred-width;
    l := HorizontalLayout {
        spacing: 6px;
        Rectangle {
            width: 14px;
            Rectangle {
                y: (parent.height - self.height) / 2;
                height: root.faint ? 1px : 2px;
                border-radius: 1px;
                background: root.swatch;
            }
        }
        Text {
            text: root.text;
            color: Theme.text-2;
            font-size: Theme.fs-small;
            vertical-alignment: center;
        }
    }
}

component Handle inherits Rectangle {
    in property <int> index;
    in property <Band> band;
    in property <length> pw;
    in property <length> ph;
    in property <bool> selected;
    in property <bool> rest;
    out property <bool> hovered: ta.has-hover;
    out property <bool> dragging: ta.pressed;
    callback pressed();
    callback moved-to(float, float);
    callback released();
    callback toggle();
    callback wheel(float);

    private property <color> c: Theme.band-color(root.index);
    private property <length> d: root.selected || ta.has-hover || ta.pressed ? 24px : 20px;
    x: root.band.x * root.pw - 18px;
    y: Math.min(1, Math.max(0, root.band.y)) * root.ph - 18px;
    width: 36px;
    height: 36px;
    accessible-role: button;
    accessible-label: "Band \{root.index + 1}, " + Fmt.hz(root.band.freq) + (root.band.has-gain ? ", " + Fmt.db(root.band.gain) : "") + (root.band.on ? "" : ", off");

    if root.selected: Rectangle {
        width: 36px;
        height: 36px;
        border-radius: 18px;
        background: root.c.with-alpha(0.14);
        border-width: 1.5px;
        border-color: root.c.with-alpha(root.rest ? 0.5 : 0.9);
    }
    if root.band.warn && !root.selected: Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.d + 8px;
        height: root.d + 8px;
        border-radius: self.width / 2;
        border-width: 1.5px;
        border-color: Theme.warn;
    }
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.d;
        height: root.d;
        border-radius: root.d / 2;
        background: !root.band.on ? Theme.sunken : root.rest ? root.c.with-alpha(0.55) : root.c;
        border-width: 2px;
        border-color: root.band.on ? Theme.sunken : root.c;
        animate width { duration: Theme.dur-fast; easing: ease-out; }
        animate height { duration: Theme.dur-fast; easing: ease-out; }
        Text {
            text: "\{root.index + 1}";
            color: root.band.on ? Theme.on-band : root.c;
            font-size: root.index >= 9 ? 10px : 11px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    if root.band.warn: Rectangle {
        x: parent.width / 2 + 5px;
        y: parent.height / 2 - 17px;
        width: 13px;
        height: 13px;
        border-radius: 7px;
        background: Theme.warn;
        border-width: 1.5px;
        border-color: Theme.sunken;
        Text {
            text: "!";
            color: Theme.dark ? #1C1500 : #FFFFFF;
            font-size: 9px;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        property <length> grab-x;
        property <length> grab-y;
        mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.pressed();
                self.grab-x = 18px - self.mouse-x;
                self.grab-y = 18px - self.mouse-y;
            }
            if (e.kind == PointerEventKind.up) { root.released(); }
        }
        moved => {
            root.moved-to(
                Math.min(1, Math.max(0, (root.x + self.mouse-x + self.grab-x) / root.pw)),
                (root.y + self.mouse-y + self.grab-y) / root.ph);
        }
        double-clicked => { root.toggle(); }
        scroll-event(e) => {
            root.wheel(-e.delta-y / 60px);
            return accept;
        }
    }
}

export component EqGraph inherits Rectangle {
    private property <length> pl: 50px;
    private property <length> pt: 20px;
    private property <length> pr: 22px;
    private property <length> pb: 32px;
    private property <length> plot-w: Math.max(40px, root.width - root.pl - root.pr);
    private property <length> plot-h: Math.max(40px, root.height - root.pt - root.pb);
    private property <bool> rest: !Model.enabled || Model.comparing;
    private property <int> sel: Model.selected-band;
    private property <int> hover-index: -1;
    private property <int> readout: root.hover-index >= 0 ? root.hover-index : root.sel;
    private property <bool> has-sel: root.sel >= 0 && root.sel < Model.bands.length;
    private property <color> line-c: root.rest ? Theme.text-3 : Theme.accent-line;

    background: Theme.sunken;
    clip: true;
    accessible-role: groupbox;
    accessible-label: "Equalizer graph. Frequency from 20 hertz to 20 kilohertz, gain in decibels.";

    // ---- grid ----
    for g in Model.grid-y: Rectangle {
        x: root.pl;
        y: root.pt + g.pos * root.plot-h;
        width: root.plot-w;
        height: 1px;
        background: g.strong ? Theme.grid-strong : Theme.grid;
    }
    for g in Model.grid-x: Rectangle {
        x: root.pl + g.pos * root.plot-w;
        y: root.pt;
        width: 1px;
        height: root.plot-h;
        background: g.strong ? Theme.grid-strong : Theme.grid;
    }
    for g in Model.grid-y: Text {
        x: 0px;
        y: root.pt + g.pos * root.plot-h - 8px;
        width: root.pl - 10px;
        height: 16px;
        text: g.label;
        horizontal-alignment: right;
        vertical-alignment: center;
        font-size: Theme.fs-caption;
        color: g.strong ? Theme.text-2 : Theme.text-3;
    }
    for g in Model.grid-x: Text {
        x: root.pl + g.pos * root.plot-w - 24px;
        y: root.pt + root.plot-h + 8px;
        width: 48px;
        height: 16px;
        text: g.label;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: Theme.fs-caption;
        color: g.strong ? Theme.text-2 : Theme.text-3;
    }

    // ---- curves ----
    plot := Rectangle {
        x: root.pl;
        y: root.pt;
        width: root.plot-w;
        height: root.plot-h;
        clip: true;
        function report() {
            Model.plot-width = self.width;
            Model.plot-height = self.height;
            Model.graph-resized(self.width, self.height);
        }
        changed width => { self.report(); }
        changed height => { self.report(); }
        init => { self.report(); }

        // selected band: a thin guide through its centre frequency
        if root.has-sel: Rectangle {
            x: Model.bands[root.sel].x * parent.width;
            width: 1px;
            height: parent.height;
            background: root.rest ? Theme.text-3.with-alpha(0.25) : Theme.band-color(root.sel).with-alpha(0.4);
        }
        PxPath {
            width: parent.width;
            height: parent.height;
            commands: Model.curve-correction;
            stroke: Theme.text-3.with-alpha(0.8);
            stroke-width: 1.25px;
        }
        PxPath {
            width: parent.width;
            height: parent.height;
            commands: Model.curve-total-fill;
            fill: @linear-gradient(180deg, root.line-c.with-alpha(root.rest ? 0.10 : (Theme.dark ? 0.24 : 0.22)) 0%, root.line-c.with-alpha(0.0) 100%);
        }
        PxPath {
            width: parent.width;
            height: parent.height;
            commands: Model.curve-selected;
            stroke: root.rest ? Theme.text-3.with-alpha(0.6) : Theme.band-color(root.sel);
            stroke-width: 1.5px;
        }
        PxPath {
            width: parent.width;
            height: parent.height;
            commands: Model.curve-right;
            stroke: root.rest ? Theme.text-3.with-alpha(0.7) : (Theme.dark ? #8FB8F0 : #2B6FCB);
            stroke-width: 2px;
        }
        PxPath {
            width: parent.width;
            height: parent.height;
            commands: Model.curve-total;
            stroke: root.line-c;
            stroke-width: 2.25px;
        }

        plot-ta := TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    fs.focus();
                    Model.selected-band = -1;
                }
            }
            double-clicked => { Model.band-add(self.mouse-x / self.width, self.mouse-y / self.height); }
            scroll-event(e) => {
                if (root.has-sel) {
                    Model.band-width(root.sel, -e.delta-y / 60px);
                    return accept;
                }
                return reject;
            }
        }
    }

    // ---- handles (not clipped, so edge handles stay whole) ----
    Rectangle {
        x: root.pl;
        y: root.pt;
        width: root.plot-w;
        height: root.plot-h;
        for b[i] in Model.bands: Handle {
            index: i;
            band: b;
            pw: root.plot-w;
            ph: root.plot-h;
            selected: i == root.sel;
            rest: root.rest;
            pressed => { Model.selected-band = i; fs.focus(); }
            moved-to(x, y) => { Model.band-drag(i, x, y); }
            released => { Model.band-drag-end(i); }
            toggle => { Model.band-set-on(i, !b.on); }
            wheel(steps) => { Model.selected-band = i; Model.band-width(i, steps); }
            changed hovered => { if (self.hovered) { root.hover-index = i; } else if (root.hover-index == i) { root.hover-index = -1; } }
        }

        // value readout for the hovered or selected band
        if root.readout >= 0 && root.readout < Model.bands.length: Rectangle {
            private property <Band> b: Model.bands[root.readout];
            private property <length> hx: b.x * parent.width;
            private property <length> hy: Math.min(1, Math.max(0, b.y)) * parent.height;
            width: rl.preferred-width;
            height: 26px;
            x: Math.min(Math.max(hx - self.width / 2, 4px), parent.width - self.width - 4px);
            y: hy - 24px - self.height < 2px ? hy + 24px : hy - 24px - self.height;
            border-radius: Theme.r-sm;
            background: Theme.dark ? Theme.surface-3 : Theme.surface;
            border-width: 1px;
            border-color: Theme.line-strong;
            drop-shadow-blur: 8px;
            drop-shadow-color: #00000040;
            drop-shadow-offset-y: 2px;
            rl := HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 10px;
                Text {
                    text: Fmt.hz(b.freq);
                    color: Theme.text;
                    font-size: Theme.fs-small;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                if b.has-gain: Text {
                    text: Fmt.db(b.gain);
                    color: b.gain >= 0 ? Theme.text : Theme.text;
                    font-size: Theme.fs-small;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                Text {
                    text: "Q " + Fmt.q(b.q);
                    color: Theme.text-2;
                    font-size: Theme.fs-small;
                    vertical-alignment: center;
                }
            }
        }
    }

    if Model.bands.length == 0: Text {
        x: root.pl;
        y: root.pt + root.plot-h * 0.62;
        width: root.plot-w;
        height: 20px;
        text: "Double click the graph to add a band";
        horizontal-alignment: center;
        vertical-alignment: center;
        color: Theme.text-2;
        font-size: Theme.fs-body;
    }

    // ---- legend and resting notice ----
    HorizontalLayout {
        x: root.pl + 10px;
        y: root.pt + 8px;
        width: root.plot-w - 20px;
        height: 18px;
        spacing: 14px;
        alignment: end;
        if Model.curve-correction != "": LegendItem { text: "Correction"; swatch: Theme.text-3; faint: true; }
        if Model.curve-selected != "": LegendItem { text: "Selected band"; swatch: Theme.band-color(root.sel); }
        if Model.curve-right != "": LegendItem { text: "Right ear"; swatch: Theme.dark ? #8FB8F0 : #2B6FCB; }
        LegendItem { text: Model.curve-right != "" ? "Left ear" : "Total"; swatch: root.line-c; }
    }
    if root.rest: Rectangle {
        x: root.pl + 10px;
        y: root.pt + 8px;
        width: nl.preferred-width;
        height: 24px;
        border-radius: 12px;
        background: Theme.surface-3;
        nl := HorizontalLayout {
            padding-left: 8px;
            padding-right: 12px;
            spacing: 6px;
            Icon { name: Model.enabled ? "compare" : "power"; size: 14px; tint: Theme.text-2; y: (parent.height - self.height) / 2; }
            Text {
                text: Model.enabled ? "Comparing: you hear the flat sound" : "Equalizer is off: the sound is unchanged";
                color: Theme.text-2;
                font-size: Theme.fs-small;
                vertical-alignment: center;
            }
        }
    }

    fs := FocusScope {
        width: 1px;
        height: 1px;
        focus-on-click: false;
        key-pressed(e) => {
            // Undo and redo work wherever focus is; the window handles them too.
            if (e.text == Key.Escape) { Model.selected-band = -1; return accept; }
            if (!root.has-sel) { return reject; }
            if (e.text == Key.Delete || e.text == Key.Backspace) { Model.band-remove(root.sel); return accept; }
            if (e.text == Key.LeftArrow) { Model.band-nudge(root.sel, e.modifiers.alt ? 2 : 0, e.modifiers.shift ? -5 : -1); return accept; }
            if (e.text == Key.RightArrow) { Model.band-nudge(root.sel, e.modifiers.alt ? 2 : 0, e.modifiers.shift ? 5 : 1); return accept; }
            if (e.text == Key.UpArrow) { Model.band-nudge(root.sel, 1, e.modifiers.shift ? 5 : 1); return accept; }
            if (e.text == Key.DownArrow) { Model.band-nudge(root.sel, 1, e.modifiers.shift ? -5 : -1); return accept; }
            if (e.text == "[" && root.sel > 0) { Model.selected-band = root.sel - 1; return accept; }
            if (e.text == "]" && root.sel < Model.bands.length - 1) { Model.selected-band = root.sel + 1; return accept; }
            return reject;
        }
    }
    // keyboard focus outline
    Rectangle {
        border-width: fs.has-focus ? 1px : 0px;
        border-color: Theme.focus.with-alpha(0.6);
        border-radius: Theme.r-lg;
    }
}
