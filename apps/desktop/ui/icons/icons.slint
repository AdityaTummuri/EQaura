// Original line icons on a 20 px grid. Drawn with a round 1.6 px stroke
// (the Icon widget scales the stroke with its size).
export global Icons {
    pure public function path(name: string) -> string {
        if (name == "eq") { return "M5 3v14 M10 3v14 M15 3v14 M3 12.5h4 M8 6.5h4 M13 14h4"; }
        if (name == "headphones") { return "M3.5 12a6.5 6.5 0 0 1 13 0 M5 11h1.5v5.5H5a1.5 1.5 0 0 1-1.5-1.5v-2.5A1.5 1.5 0 0 1 5 11z M15 11h-1.5v5.5H15a1.5 1.5 0 0 0 1.5-1.5v-2.5A1.5 1.5 0 0 0 15 11z"; }
        if (name == "hearing") { return "M6 8.2a4 4 0 0 1 8 0c0 2.2-1.600 3-2.400 4.200-.800 1.200-.300 2.800-1.900 3.600-1.500.7-3.100.1-3.600-1.300 M8.600 8.300a1.400 1.400 0 0 1 2.800 0c0 1-.9 1.300-1.300 2"; }
        if (name == "assistant") { return "M4.500 4h11a1.500 1.500 0 0 1 1.500 1.500v7a1.500 1.500 0 0 1-1.500 1.500H9.500L6 17v-3H4.500A1.500 1.500 0 0 1 3 12.500v-7A1.500 1.500 0 0 1 4.500 4z M10 6.800v4.200 M7.900 8.900h4.200"; }
        if (name == "presets") { return "M6 3.500h8a1 1 0 0 1 1 1V17l-5-3.500L5 17V4.500a1 1 0 0 1 1-1z"; }
        if (name == "system") { return "M2.500 10h3.500l2-5.500 3 11 2-5.500h4.500"; }
        if (name == "settings") { return "M15.640 8.260 L17.590 8.700 L17.590 11.300 L15.640 11.740 L15.220 12.750 L16.290 14.450 L14.450 16.290 L12.750 15.220 L11.740 15.640 L11.300 17.590 L8.700 17.590 L8.260 15.640 L7.250 15.220 L5.550 16.290 L3.710 14.450 L4.780 12.750 L4.360 11.740 L2.410 11.300 L2.410 8.700 L4.360 8.260 L4.780 7.250 L3.710 5.550 L5.550 3.710 L7.250 4.780 L8.260 4.360 L8.700 2.410 L11.300 2.410 L11.740 4.360 L12.750 4.780 L14.450 3.710 L16.290 5.550 L15.220 7.250 Z M12.200 10a2.200 2.200 0 1 1-4.400 0 2.200 2.200 0 0 1 4.400 0z"; }
        if (name == "about" || name == "info") { return "M17 10a7 7 0 1 1-14 0 7 7 0 0 1 14 0z M10 9.200v4.300 M10 6.600h.01"; }
        if (name == "power") { return "M10 3v6.500 M5.800 5.600a6 6 0 1 0 8.400 0"; }
        if (name == "undo") { return "M7.500 4.500L4 8l3.500 3.500 M4 8h7a4.500 4.500 0 0 1 0 9H8"; }
        if (name == "redo") { return "M12.500 4.500L16 8l-3.500 3.500 M16 8H9a4.500 4.500 0 0 0 0 9h3"; }
        if (name == "compare") { return "M17 10a7 7 0 1 1-14 0 7 7 0 0 1 14 0z M10 3v14 M6.500 7.500h1.500 M6.500 10h1.500 M6.500 12.500h1.500"; }
        if (name == "plus") { return "M10 4.500v11 M4.500 10h11"; }
        if (name == "minus") { return "M4.500 10h11"; }
        if (name == "close") { return "M5.500 5.500l9 9 M14.500 5.500l-9 9"; }
        if (name == "check") { return "M4.500 10.500l3.500 3.500 7.500-8"; }
        if (name == "chevron-down") { return "M5.500 8l4.500 4.500L14.500 8"; }
        if (name == "chevron-up") { return "M5.500 12l4.500-4.500L14.500 12"; }
        if (name == "chevron-right") { return "M8 5.500l4.500 4.500L8 14.500"; }
        if (name == "chevron-left") { return "M12 5.500L7.500 10l4.500 4.500"; }
        if (name == "search") { return "M14.500 9a5.500 5.500 0 1 1-11 0 5.500 5.500 0 0 1 11 0z M13 13l4 4"; }
        if (name == "trash") { return "M4 6h12 M8 6V4h4v2 M5.500 6l.8 9.600a1 1 0 0 0 1 .9h5.400a1 1 0 0 0 1-.9L14.500 6 M8.500 9v5 M11.500 9v5"; }
        if (name == "edit") { return "M12.500 4.500l3 3L7 16H4v-3z M11 6l3 3"; }
        if (name == "save") { return "M4 5a1 1 0 0 1 1-1h8l3 3v8.500a1.500 1.500 0 0 1-1.500 1.500h-9A1.500 1.500 0 0 1 4 15.500z M7 4v3.500h5V4 M7 16v-4.500h6V16"; }
        if (name == "copy") { return "M7.500 7h7a1.500 1.500 0 0 1 1.500 1.500v7a1.500 1.500 0 0 1-1.500 1.500h-7A1.500 1.500 0 0 1 6 15.500v-7A1.500 1.500 0 0 1 7.500 7z M4 13V5.500A1.500 1.500 0 0 1 5.500 4H13"; }
        if (name == "import") { return "M10 3v9 M6.500 8.500L10 12l3.500-3.500 M4 13v2.500A1.500 1.500 0 0 0 5.500 17h9a1.500 1.500 0 0 0 1.500-1.500V13"; }
        if (name == "export") { return "M10 12V3 M6.500 6.500L10 3l3.500 3.500 M4 13v2.500A1.500 1.500 0 0 0 5.500 17h9a1.500 1.500 0 0 0 1.500-1.500V13"; }
        if (name == "folder") { return "M3 6.500A1.500 1.500 0 0 1 4.500 5h3l1.800 2h6.200A1.500 1.500 0 0 1 17 8.500v6a1.500 1.500 0 0 1-1.500 1.500h-11A1.500 1.500 0 0 1 3 14.500z"; }
        if (name == "external") { return "M11.500 3H17v5.500 M17 3l-7.500 7.500 M14 12v3.500a1.500 1.500 0 0 1-1.500 1.500h-7A1.500 1.500 0 0 1 4 15.500v-7A1.500 1.500 0 0 1 5.500 7H8"; }
        if (name == "warning") { return "M10 3.800l7 12.200H3z M10 8.600v3.400 M10 14.200h.01"; }
        if (name == "alert") { return "M17 10a7 7 0 1 1-14 0 7 7 0 0 1 14 0z M10 6.500v4 M10 13.200h.01"; }
        if (name == "check-circle") { return "M17 10a7 7 0 1 1-14 0 7 7 0 0 1 14 0z M6.800 10.200l2.200 2.200 4.200-4.600"; }
        if (name == "play") { return "M7 4.500v11l8.500-5.500z"; }
        if (name == "stop") { return "M6 6h8v8H6z"; }
        if (name == "refresh") { return "M16 10a6 6 0 1 1-1.800-4.300 M16 3.500V7h-3.500"; }
        if (name == "reset") { return "M4 10a6 6 0 1 0 1.800-4.300 M4 3.500V7h3.500"; }
        if (name == "send") { return "M10 16V4.500 M5 9.500l5-5 5 5"; }
        if (name == "sparkle") { return "M10 3c.6 4 2.500 6 7 7-4.500.900-6.400 3-7 7-.6-4-2.500-6.100-7-7 4.500-1 6.400-3 7-7z"; }
        if (name == "key") { return "M7.500 7.800a3 3 0 1 0 .01 0z M9.800 10l6.200 6.200 M13.800 14l1.700-1.700 M15.500 15.700l1.500-1.500"; }
        if (name == "device") { return "M4.500 4.500h11A1 1 0 0 1 16.500 5.500v7a1 1 0 0 1-1 1h-11a1 1 0 0 1-1-1v-7a1 1 0 0 1 1-1z M7.500 16.500h5 M10 13.500v3"; }
        if (name == "lock") { return "M5.500 9h9a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1h-9a1 1 0 0 1-1-1v-6a1 1 0 0 1 1-1z M7.500 9V6.500a2.500 2.500 0 0 1 5 0V9"; }
        if (name == "eye") { return "M2.500 10s3-5.500 7.500-5.500S17.500 10 17.500 10s-3 5.500-7.500 5.500S2.500 10 2.500 10z M12 10a2 2 0 1 1-4 0 2 2 0 0 1 4 0z"; }
        if (name == "curve") { return "M3 14.500c3 0 3.500-9 7-9s4 9 7 9"; }
        if (name == "sliders") { return "M5 3.500v13 M10 3.500v13 M15 3.500v13 M3.500 11h3 M8.500 7h3 M13.500 12.500h3"; }
        if (name == "spinner") { return "M10 3a7 7 0 1 0 7 7"; }
        if (name == "volume") { return "M3.500 8h2.800L10 4.800v10.400L6.300 12H3.500z M13 7.500a3.500 3.500 0 0 1 0 5 M15.200 5.300a6.500 6.500 0 0 1 0 9.400"; }
        if (name == "bolt") { return "M11 3L5 11.500h4.500L9 17l6-8.500h-4.500z"; }
        if (name == "ear-left") { return "M5 10h7 M8.500 6.500L5 10l3.500 3.500"; }
        return "";
    }
}
